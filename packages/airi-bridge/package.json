{
  "name": "@bright/airi-bridge",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic + React layer for a talking Live2D avatar. Ports the framework-free parts of Project AIRI (MIT) to React.",
  "license": "MIT",
  "sideEffects": [
    "./src/live2d/live2d-zip-loader.ts",
    "./dist/live2d/live2d-zip-loader.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./act": {
      "types": "./dist/act/index.d.ts",
      "default": "./dist/act/index.js"
    },
    "./live2d": {
      "types": "./dist/live2d/index.d.ts",
      "default": "./dist/live2d/index.js"
    },
    "./live2d/zip-loader": {
      "types": "./dist/live2d/live2d-zip-loader.d.ts",
      "default": "./dist/live2d/live2d-zip-loader.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vendor": {
      "types": "./dist/vendor/index.d.ts",
      "default": "./dist/vendor/index.js"
    },
    "./lipsync": {
      "types": "./dist/vendor/model-driver-lipsync/live2d/index.d.ts",
      "default": "./dist/vendor/model-driver-lipsync/live2d/index.js"
    },
    "./wlipsync-profile.json": "./src/vendor/model-driver-lipsync/shared/wlipsync/profile.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@moeru/eventa": "1.0.0-beta.14",
    "@pixi/app": "^6.5.10",
    "@pixi/constants": "^6.5.10",
    "@pixi/core": "^6.5.10",
    "@pixi/display": "^6.5.10",
    "@pixi/extensions": "^6.5.10",
    "@pixi/loaders": "^6.5.10",
    "@pixi/math": "^6.5.10",
    "@pixi/runner": "^6.5.10",
    "@pixi/settings": "^6.5.10",
    "@pixi/sprite": "^6.5.10",
    "@pixi/ticker": "^6.5.10",
    "@pixi/utils": "^6.5.10",
    "clustr": "^1.0.2",
    "jszip": "^3.10.1",
    "pixi-live2d-display": "^0.4.0",
    "wlipsync": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
