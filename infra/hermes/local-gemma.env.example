# Drop-in model-side changes for the later local Gemma migration.
# The Bright adapter still calls http://127.0.0.1:8642/v1/responses; only
# Hermes' upstream provider changes.
HERMES_MODEL_PROVIDER=custom
HERMES_MODEL_BASE_URL=http://127.0.0.1:9000/v3
HERMES_MODEL_API_KEY=
HERMES_MODEL_NAME=OpenVINO/gemma-4-E4B-it-int4-ov
# Gemma/OpenVINO is not MiMo's OpenAI-compatible thinking contract.
HERMES_MODEL_MIMO_DISABLE_THINKING=false

# Only set this after the endpoint above is verified to be loopback/local.
# It lets Core include the selected learner's own name and notes while keeping
# the same strict learner scope. Hosted deployments remain hosted-minimal.
AGENT_CONTEXT_POLICY=local-trusted
