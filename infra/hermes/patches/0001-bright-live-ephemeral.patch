new file mode 100644
index 000000000..98fc71281
--- /dev/null
+++ b/agent/bright_live.py
@@ -0,0 +1,182 @@
+"""Narrow, auditable policy for Bright's ephemeral live-teacher profile.
+
+This module deliberately has no provider, gateway or persistence imports so
+the safety policy can be tested without constructing the full agent runtime.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Sequence
+
+
+BRIGHT_PATCH_VERSION = "0.20.0+bright.2"
+
+
+def _truthy(value: Any) -> bool:
+    """Parse the profile's explicitly opt-in string/boolean switches."""
+
+    if isinstance(value, bool):
+        return value
+    return str(value or "").strip().lower() in {"1", "true", "yes", "on"}
+
+
+@dataclass(frozen=True)
+class BrightLiveProfile:
+    enabled: bool = False
+    terminal_tool: str = "classroom_propose_move"
+    system_prompt: str = ""
+    # MiMo's OpenAI-compatible endpoint requires this non-standard field at
+    # the top-level JSON body. It is opt-in so alternative providers keep
+    # their native request contract.
+    mimo_disable_thinking: bool = False
+
+    @classmethod
+    def from_extra(cls, extra: Mapping[str, Any] | None) -> "BrightLiveProfile":
+        raw = (extra or {}).get("bright_live")
+        if not isinstance(raw, Mapping):
+            return cls()
+        enabled = raw.get("enabled") is True
+        terminal_tool = str(raw.get("terminal_tool") or "classroom_propose_move").strip()
+        system_prompt = str(raw.get("system_prompt") or "").strip()
+        if enabled and (not terminal_tool or not system_prompt):
+            raise ValueError(
+                "bright_live requires non-empty terminal_tool and system_prompt"
+            )
+        return cls(
+            enabled=enabled,
+            terminal_tool=terminal_tool,
+            system_prompt=system_prompt,
+            mimo_disable_thinking=_truthy(raw.get("mimo_disable_thinking")),
+        )
+
+
+def validate_responses_request(
+    profile: BrightLiveProfile,
+    body: Mapping[str, Any],
+    headers: Mapping[str, Any],
+) -> str | None:
+    """Return a client-safe rejection reason for a live request, else None."""
+
+    if not profile.enabled:
+        return None
+    lower_headers = {str(key).lower(): value for key, value in headers.items()}
+    for header in ("x-hermes-session-key", "x-hermes-session-id", "idempotency-key"):
+        if lower_headers.get(header):
+            return f"Bright live requests cannot use session/chaining header {header!r}"
+
+    for field in (
+        "instructions",
+        "previous_response_id",
+        "conversation",
+        "conversation_history",
+        "tools",
+        "provider",
+        "model_options",
+    ):
+        if field in body:
+            return f"Bright live requests cannot set {field!r}"
+    if body.get("store") is not False:
+        return "Bright live requests require 'store' to be false"
+    if body.get("stream") is not True:
+        return "Bright live requests require 'stream' to be true"
+    if not isinstance(body.get("input"), str):
+        return "Bright live 'input' must be one self-contained string"
+    if not body["input"].strip():
+        return "Bright live 'input' cannot be empty"
+    return None
+
+
+def configure_bright_live_agent(agent: Any, profile: BrightLiveProfile) -> Any:
+    """Apply path-independent isolation and single-inference policy."""
+
+    if not profile.enabled:
+        return agent
+    agent._bright_live_profile = profile
+    agent._bright_live_terminal_tool = profile.terminal_tool
+    agent._persist_disabled = True
+    agent._session_db = None
+    agent._owns_session_db = False
+    agent._session_json_enabled = False
+    agent.save_trajectories = False
+    agent.skip_memory = True
+    agent.skip_background_review = True
+    agent.max_iterations = 1
+    # Hermes counts the first attempt in this value: 1 means zero retries.
+    agent._api_max_retries = 1
+    # The live profile has exactly one legal terminal tool. Pinning the exact
+    # function, rather than merely requiring any tool, prevents a provider
+    # from choosing an incidental gateway capability or spending the classroom
+    # deadline composing discarded assistant prose.
+    enforce_bright_live_wire_policy(agent)
+    agent.fallback_model = None
+    agent.ephemeral_system_prompt = None
+    agent._cached_system_prompt = profile.system_prompt
+    agent._cached_system_prompt_static = profile.system_prompt
+    agent._disable_request_dumps = True
+    return agent
+
+
+def enforce_bright_live_wire_policy(agent: Any) -> Any:
+    """Reapply terminal-tool wire constraints after upstream turn routing."""
+
+    profile = getattr(agent, "_bright_live_profile", None)
+    if isinstance(profile, BrightLiveProfile) and profile.enabled:
+        request_overrides = dict(getattr(agent, "request_overrides", {}) or {})
+        request_overrides["tool_choice"] = {
+            "type": "function",
+            "function": {"name": profile.terminal_tool},
+        }
+        if profile.mimo_disable_thinking:
+            # ``extra_body`` is the OpenAI SDK escape hatch: it serializes
+            # its entries into the JSON body at the top level. Nesting this
+            # under a literal ``extra_body`` JSON field would not disable
+            # MiMo reasoning and would consume the classroom deadline.
+            provider_extra = dict(request_overrides.get("extra_body", {}) or {})
+            provider_extra["thinking"] = {"type": "disabled"}
+            request_overrides["extra_body"] = provider_extra
+        agent.request_overrides = request_overrides
+    return agent
+
+
+def select_terminal_tool_calls(
+    profile: BrightLiveProfile | None,
+    tool_calls: Sequence[Any],
+) -> list[Any]:
+    """Return at most the first configured terminal call in live mode."""
+
+    if profile is None or not profile.enabled:
+        return list(tool_calls)
+    for tool_call in tool_calls:
+        function = getattr(tool_call, "function", None)
+        name = str(getattr(function, "name", None) or "")
+        if name == profile.terminal_tool or name.endswith(f"__{profile.terminal_tool}"):
+            return [tool_call]
+    return []
+
+
+def finalizer_inference_allowed(agent: Any) -> bool:
+    """Whether turn finalization may issue its extra summary inference."""
+
+    profile = getattr(agent, "_bright_live_profile", None)
+    return not isinstance(profile, BrightLiveProfile) or not profile.enabled
+
+
+def bounded_retry_ceiling(agent: Any, current: int, requested: int) -> int:
+    """Keep provider-specific retry escalations out of a Bright live turn."""
+
+    if not finalizer_inference_allowed(agent):
+        return 1
+    return max(current, requested)
+
+
+__all__ = [
+    "BRIGHT_PATCH_VERSION",
+    "BrightLiveProfile",
+    "bounded_retry_ceiling",
+    "configure_bright_live_agent",
+    "enforce_bright_live_wire_policy",
+    "finalizer_inference_allowed",
+    "select_terminal_tool_calls",
+    "validate_responses_request",
+]
