+++ b/tests/agent/test_bright_live_profile.py
@@ -0,0 +1,167 @@
+"""Bright live-classroom invariants for the pinned Hermes build."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from agent.agent_runtime_helpers import dump_api_request_debug
+from agent.bright_live import (
+    BRIGHT_PATCH_VERSION,
+    BrightLiveProfile,
+    bounded_retry_ceiling,
+    configure_bright_live_agent,
+    enforce_bright_live_wire_policy,
+    finalizer_inference_allowed,
+    select_terminal_tool_calls,
+    validate_responses_request,
+)
+
+
+PROMPT = "Call classroom_propose_move exactly once."
+
+
+def _profile() -> BrightLiveProfile:
+    return BrightLiveProfile(
+        enabled=True,
+        terminal_tool="classroom_propose_move",
+        system_prompt=PROMPT,
+    )
+
+
+def test_patch_has_a_distinct_local_version():
+    assert BRIGHT_PATCH_VERSION == "0.20.0+bright.2"
+
+
+def test_mimo_thinking_switch_is_profile_scoped_and_uses_sdk_extra_body():
+    enabled = BrightLiveProfile.from_extra(
+        {
+            "bright_live": {
+                "enabled": True,
+                "terminal_tool": "classroom_propose_move",
+                "system_prompt": PROMPT,
+                "mimo_disable_thinking": "true",
+            }
+        }
+    )
+    agent = SimpleNamespace(
+        _bright_live_profile=enabled,
+        request_overrides={"extra_body": {"provider_hint": "keep"}},
+    )
+    enforce_bright_live_wire_policy(agent)
+    assert agent.request_overrides == {
+        "tool_choice": {
+            "type": "function",
+            "function": {"name": "classroom_propose_move"},
+        },
+        "extra_body": {
+            "provider_hint": "keep",
+            "thinking": {"type": "disabled"},
+        },
+    }
+
+    disabled = BrightLiveProfile.from_extra(
+        {
+            "bright_live": {
+                "enabled": True,
+                "terminal_tool": "classroom_propose_move",
+                "system_prompt": PROMPT,
+                "mimo_disable_thinking": "false",
+            }
+        }
+    )
+    other_provider = SimpleNamespace(
+        _bright_live_profile=disabled,
+        request_overrides={"extra_body": {"native_option": "keep"}},
+    )
+    enforce_bright_live_wire_policy(other_provider)
+    assert other_provider.request_overrides == {
+        "tool_choice": {
+            "type": "function",
+            "function": {"name": "classroom_propose_move"},
+        },
+        "extra_body": {"native_option": "keep"},
+    }
+
+
+@pytest.mark.parametrize(
+    "mutation, expected",
+    [
+        ({"instructions": "client override"}, "instructions"),
+        ({"previous_response_id": "resp_old"}, "previous_response_id"),
+        ({"conversation": "room"}, "conversation"),
+        ({"conversation_history": []}, "conversation_history"),
+        ({"tools": []}, "tools"),
+        ({"store": True}, "store"),
+        ({"stream": False}, "stream"),
+        ({"input": [{"role": "user", "content": "history"}]}, "input"),
+    ],
+)
+def test_live_request_rejects_prompt_state_storage_and_nonstreaming(mutation, expected):
