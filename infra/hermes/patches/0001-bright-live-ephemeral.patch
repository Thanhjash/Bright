+"""Gateway boundary tests for Bright's constrained live profile."""
+
+from unittest.mock import AsyncMock
+
+import pytest
+pytest.importorskip("aiohttp")
+from aiohttp import web
+from aiohttp.test_utils import TestClient, TestServer
+
+from gateway.config import PlatformConfig
+from gateway.platforms.api_server import APIServerAdapter
+
+
+def _adapter() -> APIServerAdapter:
+    return APIServerAdapter(
+        PlatformConfig(
+            enabled=True,
+            extra={
+                "bright_live": {
+                    "enabled": True,
+                    "terminal_tool": "classroom_propose_move",
+                    "system_prompt": "Call classroom_propose_move exactly once.",
+                }
+            },
+        )
+    )
+
+
+def test_live_profile_registers_only_health_models_and_responses():
+    adapter = _adapter()
+    assert adapter._response_store._db_path is None
+    routes = {(method, path) for method, path, _handler in adapter._http_route_table()}
+    assert routes == {
+        ("GET", "/health"),
+        ("GET", "/health/detailed"),
+        ("GET", "/v1/health"),
+        ("GET", "/v1/models"),
+        ("POST", "/v1/responses"),
+    }
+
+
+def test_required_live_profile_fails_closed_when_config_extension_is_missing(monkeypatch):
+    monkeypatch.setenv("BRIGHT_REQUIRE_LIVE_PROFILE", "1")
+
+    with pytest.raises(RuntimeError, match="bright_live is missing or disabled"):
+        APIServerAdapter(PlatformConfig(enabled=True, extra={}))
+
+
+@pytest.mark.asyncio
+async def test_invalid_live_request_is_rejected_before_agent_slot_is_consumed():
+    adapter = _adapter()
+    adapter._run_agent = AsyncMock()
+    app = web.Application()
+    app["api_server_adapter"] = adapter
+    app.router.add_post("/v1/responses", adapter._handle_responses)
+
+    async with TestClient(TestServer(app)) as client:
+        response = await client.post(
+            "/v1/responses",
+            json={
+                "model": "bright-classroom",
+                "instructions": "replace server policy",
+                "input": "fresh state",
+                "stream": True,
+                "store": False,
+            },
+        )
+        assert response.status == 400
+        assert "instructions" in (await response.json())["error"]["message"]
+
+    adapter._run_agent.assert_not_awaited()
