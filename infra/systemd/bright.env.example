# Bright appliance configuration. Installed to /etc/bright/bright.env.
#
# systemd reads this file directly (EnvironmentFile=), so it is NOT a shell
# script: no `export`, no quotes around values unless the value contains them,
# no command substitution, no comments on the same line as a value.

# --- where things live ------------------------------------------------------
# /opt/bright/current is a symlink to the active release. scripts/usb-update.sh
# flips it atomically, so a half-copied update can never be the one that boots.
DATA_DIR=/var/lib/bright
CORE_DB_PATH=/var/lib/bright/bright.db
CONTENT_DIR=/var/lib/bright/content
PIPER_DIR=/var/lib/bright/models/piper
WHISPER_DIR=/var/lib/bright/models/whisper

# Leave empty to use the built-in sample lesson's own media root. Pointing this
# at content/media makes the sample lesson's asset:// refs 404.
ASSETS_DIR=

# --- ports (loopback only, always) ------------------------------------------
SPEECH_PORT=8001
CORE_PORT=8004
UI_PORT=3000
HERMES_PORT=8642

# --- kiosk ------------------------------------------------------------------
KIOSK_URL=http://127.0.0.1:3000/classroom
KIOSK_STATE_DIR=/var/lib/bright/kiosk
# Set only if the browser is not on PATH under one of the usual names.
CHROMIUM_BIN=

# --- speech -----------------------------------------------------------------
# small.en is the measured default. tiny.en is 5x faster to load and to run;
# switch on a slow box and accept worse accuracy on noisy child speech.
WHISPER_MODEL=small.en
WHISPER_COMPUTE=int8
# 0 = all cores. On a 4-core appliance, cap this at 3 so Whisper cannot starve
# classroom-core's reflex tier while it transcribes.
WHISPER_THREADS=0

# --- language model ---------------------------------------------------------
# Phase 1 uses a hosted model, which means the agent layer is the ONE part of
# this system that needs internet. That is acceptable only because NS-1 makes
# it optional: with no key, or no link, classroom-core plays lesson_run.json
# and the class still runs end to end. Leave these empty on an offline
# appliance -- do not leave a dead URL that every turn waits 6 s to time out on.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DISABLE_THINKING=true

# --- Hermes primary runtime -------------------------------------------------
# Core calls only this local API. Keep the two local bearer secrets identical
# on one appliance, but generate a different random value for every machine.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=CHANGE-ME
API_SERVER_KEY=CHANGE-ME
BRIGHT_MCP_TOKEN=CHANGE-ME-TOO

# Hosted now. To move to local Gemma later, change only MODEL_BASE_URL and
# MODEL_NAME (and leave MODEL_API_KEY empty); Bright Core/UI do not change.
HERMES_MODEL_PROVIDER=custom
HERMES_MODEL_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
HERMES_MODEL_API_KEY=
HERMES_MODEL_NAME=mimo-v2.5-pro
HERMES_API_MODEL=bright-classroom
HERMES_API_TIMEOUT_S=20
HERMES_CONNECT_TIMEOUT_S=1
BRIGHT_AGENT=hermes
# Hosted inference receives pseudonymous current-turn context only. Change to
# local-trusted only after the provider URL points to the appliance itself.
AGENT_CONTEXT_POLICY=hosted-minimal
# Hosted production sends only Core-graded semantic events. Raw transcript is
# allowed solely under synthetic_dev with CORE_DEV=1, the explicit ACK below,
# and a per-event synthetic fixture id. Local Gemma may use local_trusted.
BRIGHT_DATA_POLICY=hosted_semantic
BRIGHT_SYNTHETIC_DEV_ACK=0

# How long the runner waits for the agent before taking the authored branch.
# This is a promise about how long a child may stare at a frozen board.
AGENT_TURN_TIMEOUT_S=6.0
# If Stage disappears or never acknowledges authored playback, Core releases
# the activity instead of deadlocking the offline lesson.
CORE_PLAYBACK_ACK_TIMEOUT_S=10.0

# --- behaviour --------------------------------------------------------------
# Dev push endpoints. Turn OFF on an appliance in a school.
CORE_DEV=0
CORE_AUTOSTART_LESSON=0
