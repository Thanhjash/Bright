# Copy to .env and fill in. NEVER commit .env.

# --- LLM provider (Phase 1: remote MiMo. Phase 3: local OVMS/llama.cpp) ---
LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
LLM_API_KEY=CHANGE-ME-HOSTED-PROVIDER-KEY
LLM_MODEL=mimo-v2.5-pro
# MiMo-specific: MUST be a top-level request field, not nested in extra_body,
# or reasoning stays on and burns the whole completion budget.
LLM_DISABLE_THINKING=true

# --- Ideal hosted classroom profile (Option B) -----------------------------
# `scripts/ideal-hosted.sh` reuses the LLM_* provider configuration above by
# default (with `provider=custom`). This keeps the hosted Hermes teacher on the
# same configured OpenAI-compatible provider as the existing agent.
#
# HERMES_MODEL_* are optional overrides for a different hosted/local backend.
# Leave them commented out unless this profile must use a different endpoint.
# No local gateway or MCP credential is needed in .env: the launcher generates
# fresh loopback-only credentials in memory when they are missing or are
# placeholders. It never prints or persists those values.
#
# Copy this file to `.env`, replace the LLM_API_KEY placeholder, then run
# `./scripts/ideal-hosted.sh check` before starting the hosted profile.
#
# This profile sends the current raw ASR transcript to the hosted agent provider
# for the live turn. `hosted_ephemeral_transcript` is intentionally explicit:
# use it only for an approved, ideal-condition run whose transcript handling
# is ephemeral under the provider agreement. BRIGHT_HOSTED_RAW_ACK stays 0
# until the operator has reviewed and accepts that raw-transcript boundary;
# `ideal-hosted.sh` refuses to run unless it is changed to 1.
# HERMES_MODEL_PROVIDER=custom
# HERMES_MODEL_BASE_URL=http://127.0.0.1:9000/v1
# HERMES_MODEL_API_KEY=CHANGE-ME-LOCAL-PROVIDER-KEY
# HERMES_MODEL_NAME=gemma-4
# MiMo only: inherited from LLM_DISABLE_THINKING for the legacy LLM_* profile.
# Set explicitly to false for any alternate/local backend that rejects it.
# HERMES_MODEL_MIMO_DISABLE_THINKING=false
BRIGHT_DATA_POLICY=hosted_ephemeral_transcript
BRIGHT_HOSTED_RAW_ACK=0

# --- Services ---
CORE_HOST=127.0.0.1
CORE_PORT=8004
HERMES_BASE_URL=http://127.0.0.1:8642/v1
UI_PORT=3000

# --- TTS (Phase 1: whatever is reachable; Phase 3: local Piper) ---
TTS_BASE_URL=
TTS_API_KEY=
TTS_VOICE=

# --- Paths ---
CONTENT_DIR=./content
DATA_DIR=./data
# Optional. LEAVE EMPTY unless you are serving a specific lesson's media.
# classroom-core defaults to its own services/classroom-core/assets/, which is
# where the built-in sample lesson's images live. Pointing this at content/media
# makes the sample lesson's asset:// refs 404 — they are different lessons with
# different media roots.
ASSETS_DIR=
