# Copy to .env.local to override. Every value below is also the built-in
# default, so the app runs with no .env at all.

# Drive the UI from local fixtures with no backend. `pnpm dev:mock` sets this
# via .env.mock — you only need it here if you want mock on the default script.
# VITE_MOCK=1

# classroom-core event bus
VITE_BUS_URL=ws://127.0.0.1:8004/ws

# classroom-core HTTP origin — serves GET /assets/<id>
VITE_CORE_HTTP=http://127.0.0.1:8004
