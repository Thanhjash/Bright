{
  "v": 2,
  "lessonId": "product-smoke-option-b",
  "classId": "smoke",
  "title": "Option B product smoke",
  "focus": ["runtime_contract"],
  "review": [],
  "studentsToCheck": ["smoke-learner"],
  "mediaManifest": [],
  "activities": [
    {
      "id": "smoke_hook",
      "scene": "text",
      "props": {"text": "Bright is ready.", "size": "lg"},
      "narration": [{"text": "Hello. Let us begin."}],
      "durationS": 1
    },
    {
      "id": "smoke_choice",
      "scene": "choice",
      "props": {
        "prompt": "Choose the sun.",
        "options": [
          {"id": "sun", "text": "sun"},
          {"id": "moon", "text": "moon"}
        ]
      },
      "narration": [{"text": "Which one is the sun?"}],
      "expect": {"kind": "choice", "correct": "sun"},
      "branches": [
        {
          "on": "correct",
          "goto": "smoke_wrap",
          "narration": [{"text": "Correct. That is the sun."}]
        },
        {"on": "near", "goto": "smoke_wrap"},
        {"on": "wrong", "goto": "smoke_wrap"},
        {"on": "silence", "goto": "smoke_wrap"},
        {"on": "timeout", "goto": "smoke_wrap"}
      ]
    },
    {
      "id": "smoke_wrap",
      "scene": "text",
      "props": {"text": "Finished.", "size": "lg"},
      "narration": [{"text": "Well done. The lesson is complete."}],
      "durationS": 1
    }
  ]
}
