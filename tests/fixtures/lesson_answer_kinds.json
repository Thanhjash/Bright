{
  "v": 3,
  "lessonId": "test-answer-kinds",
  "classId": "test",
  "title": "Answer kinds",
  "focus": ["animal_vocab"],
  "review": [],
  "studentsToCheck": ["minh"],
  "mediaManifest": [],
  "activities": [
    {
      "id": "say_cat",
      "scene": "vocabulary",
      "props": {
        "items": [{ "id": "cat", "text": "cat" }],
        "interaction": "none"
      },
      "narration": [{ "text": "Say it with me: cat." }],
      "expect": { "kind": "speech", "correct": ["cat"], "acceptFuzzy": ["cad"] },
      "branches": [
        { "on": "correct", "goto": "drag_cat" },
        { "on": "near", "goto": "help_say" },
        { "on": "wrong", "goto": "help_say" },
        { "on": "silence", "goto": "help_say" },
        { "on": "timeout", "goto": "help_say" }
      ]
    },
    {
      "id": "help_say",
      "scene": "text",
      "props": { "text": "Listen again: cat." },
      "durationS": 3,
      "branches": [{ "on": "always", "goto": "drag_cat" }]
    },
    {
      "id": "drag_cat",
      "scene": "matching",
      "props": {
        "left": [{ "id": "cat", "text": "cat" }],
        "right": [{ "id": "meow", "text": "meow" }, { "id": "woof", "text": "woof" }],
        "solved": []
      },
      "narration": [{ "text": "Put the sound with the animal." }],
      "expect": { "kind": "drag", "correct": ["meow"], "acceptFuzzy": ["cat>woof"] },
      "branches": [
        { "on": "correct", "goto": "the_end" },
        { "on": "near", "goto": "help_drag" },
        { "on": "wrong", "goto": "help_drag" },
        { "on": "silence", "goto": "help_drag" },
        { "on": "timeout", "goto": "help_drag" }
      ]
    },
    {
      "id": "help_drag",
      "scene": "text",
      "props": { "text": "A cat says meow." },
      "durationS": 3,
      "branches": [{ "on": "always", "goto": "the_end" }]
    },
    {
      "id": "the_end",
      "scene": "text",
      "props": { "text": "Well done!" },
      "durationS": 3
    }
  ]
}
